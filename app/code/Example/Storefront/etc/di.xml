<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Example\Storefront\Api\GreeterInterface"
                type="Example\Storefront\Model\Greeter"/>
    <preference for="Example\Storefront\Api\CatalogBadgeInterface"
                type="Example\Storefront\Model\CatalogBadge"/>
    <type name="Example\Storefront\Model\CatalogBadge">
        <arguments>
            <argument name="rules" xsi:type="array">
                <item name="new_arrival" xsi:type="object">Example\Storefront\Model\Badge\NewArrivalRule</item>
                <item name="sale" xsi:type="object">Example\Storefront\Model\Badge\SaleRule</item>
            </argument>
        </arguments>
    </type>
</config>
