<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="example_storefront_subscription" resource="default" engine="innodb"
           comment="Auto-Replenishment Subscriptions">
        <column xsi:type="int" name="subscription_id" unsigned="true" nullable="false"
                identity="true" comment="Subscription ID"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="false"
                comment="Customer ID"/>
        <column xsi:type="int" name="product_id" unsigned="true" nullable="false"
                comment="Product ID"/>
        <column xsi:type="varchar" name="cadence" nullable="false" length="32"
                comment="Replenishment cadence: weekly, monthly, quarterly"/>
        <column xsi:type="date" name="next_delivery_date" nullable="false"
                comment="Next scheduled delivery date"/>
        <column xsi:type="varchar" name="status" nullable="false" length="16"
                default="active" comment="Subscription status: active, paused, cancelled"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="subscription_id"/>
        </constraint>
        <index referenceId="EXAMPLE_STOREFRONT_SUBSCRIPTION_CUSTOMER_ID" indexType="btree">
            <column name="customer_id"/>
        </index>
        <index referenceId="EXAMPLE_STOREFRONT_SUBSCRIPTION_STATUS_NEXT_DELIVERY"
               indexType="btree">
            <column name="status"/>
            <column name="next_delivery_date"/>
        </index>
    </table>
</schema>
